#!/usr/bin/env bash

RUN_ONLY_FILE="$1"
COMPILER=${COMPILER:-gdc-15}

CFLAGS="-D_GNU_SOURCE -UNDEBUG -DZEND_SIGNALS -DZEND_ENABLE_STATIC_TSRMLS_CACHE=1"
CFLAGS="$CFLAGS -I$PHPSOURCE -I$PHPSOURCE/main -I$PHPSOURCE/TSRM -I$PHPSOURCE/Zend -I$PHPSOURCE/ext/ffi/";

# first we compile binary of every supported PHP version
if [ -v PHPSOURCE ]; then
  versions=(83         84         85        86)
  branches=(PHP-8.3.30 PHP-8.4.17 PHP-8.5.2 master)
  PHPMOD="$PWD"

  cd "$PHPSOURCE"

  for i in {0..3}; do

    BINARY="$PHPMOD/build/php${versions[i]}debug"
    if [ ! -f $BINARY ]; then
      git checkout "${branches[i]}"
      ./buildconf
      ./configure --disable-all --enable-cli --with-readline --enable-debug
      mkdir -p "$PHPMOD/build/headers${versions[i]}debug"
      cp --parents main/*.h   "$PHPMOD/build/headers${versions[i]}debug"
      cp --parents main/*/*.h "$PHPMOD/build/headers${versions[i]}debug"
      cp --parents TSRM/*.h   "$PHPMOD/build/headers${versions[i]}debug"
      cp --parents Zend/*.h   "$PHPMOD/build/headers${versions[i]}debug"
      make clean
      make -j$(nproc --all)
      mv sapi/cli/php "$BINARY"
    fi

    BINARY="$PHPMOD/build/php${versions[i]}"
    if [ ! -f $BINARY ]; then
      git checkout "${branches[i]}"
      ./buildconf
      ./configure --disable-all --enable-cli --with-readline
      mkdir -p "$PHPMOD/build/headers${versions[i]}"
      cp --parents main/*.h   "$PHPMOD/build/headers${versions[i]}"
      cp --parents main/*/*.h "$PHPMOD/build/headers${versions[i]}"
      cp --parents TSRM/*.h   "$PHPMOD/build/headers${versions[i]}"
      cp --parents Zend/*.h   "$PHPMOD/build/headers${versions[i]}"
      make clean
      make -j$(nproc --all)
      mv sapi/cli/php "$BINARY"
    fi

  done

  cd "$PHPMOD"
fi


function run {
  version="$1"
  DFile="$2"
  PHPFile="${3:-tests/empty.php}"
  SOFile="build/${DFile/\//_}.${version}debug.so"

  if [ "$RUN_ONLY_FILE" != "" ] && [ $DFile != $RUN_ONLY_FILE ]; then
    return
  fi

  echo "$COMPILER $version $DFile $PHPFile"

  if [[ "$COMPILER" == gdc* ]]; then
    $COMPILER -g -Wall -shared -fPIC -fpreview=all -fversion=PHP$version -fversion=ZEND_DEBUG -fdebug -march=native phpmod.d $DFile -o $SOFile &&
    build/php${version}debug -d extension=./$SOFile $PHPFile
  elif [[ "$COMPILER" == ldc* ]]; then
    $COMPILER -g -shared --preview=all --d-version=PHP$version --d-version=ZEND_DEBUG --d-debug -mcpu=native phpmod.d $DFile --of=$SOFile &&
    build/php${version}debug -d extension=./$SOFile $PHPFile
  else
    echo "unknown compiler $COMPILER"
  fi
}

mkdir -p build

for version in 83 84 85 86; do
  run $version tests/test.d       tests/test.php
  run $version tests/classes.d    tests/classes.php
  run $version tests/strings.d    tests/strings.php
  run $version tests/arrays.d     tests/arrays.php
  #run $version tests/ffidata.d    tests/ffidata.php
  run $version tests/zendapi.d    tests/zendapi.php
  run $version examples/api.d
  run $version examples/arrays.d  tests/ex-arrays.php
  run $version examples/popcnt.d
  run $version examples/simple.d  tests/ex-simple.php
  run $version examples/unpack.d  tests/ex-unpack.php
  run $version examples/combinations.d tests/ex-combinations.php
  run $version examples/writer.d
  run $version examples/bloom.d   tests/ex-bloom.php
  #run version tests/userland-class.d tests/userland-class.php

  #compile -I examples/ examples/cmod.d     tests/cmod.php
  #compile -fno-druntime tests/noruntime.d
done
